---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import VerticalImageCard from "../components/VerticalImageCard.astro";
---

<BaseLayout
  title="La sophrologie est-elle faite pour vous ? – Alexandra Coirier"
  description="Découvrez si la sophrologie à Loudéac peut vous aider à apaiser l’anxiété, le stress, les émotions, la surcharge mentale et retrouver un équilibre durable."
>
  <Header />

  <main>
    <section class="mx-auto max-w-7xl px-0 sm:px-6 py-8 md:py-16">
      <!-- INTRO -->
      <section class="grid lg:grid-cols-[1.15fr_0.85fr] gap-6 md:gap-8 items-stretch">
        <div class="soft-card rounded-[1.5rem] md:rounded-[2.5rem] p-5 md:p-10 slide-right flex flex-col justify-center">
          <p class="text-sm uppercase tracking-[0.25em] text-[var(--brown-soft)]">
            Sophrologie
          </p>

          <h1 class="mt-4 text-4xl md:text-5xl font-semibold text-[var(--brown-deep)]">
            Est-ce que la sophrologie est faite pour vous ?
          </h1>

          <p class="mt-6 text-xl leading-relaxed text-[var(--text)]">
            Un chemin qui commence là où vous en êtes.
          </p>
        </div>

        <VerticalImageCard
          src="/images/sophro/moi-au-milieu-des-cerisiers-2.webp"
          alt="Alexandra Coirier sophrologue"
          ratio="4 / 5"
          objectPosition="center 60%"
          animation="slide-left"
          className="h-full"
          mobileStart="50%"
          mobileMiddle="100%"
          mobileEnd="60%"
        />
      </section>

      <section class="mt-8 section-bg-new rounded-none sm:rounded-[2.5rem] p-4 sm:p-6 md:p-10">
        <!-- BLOC 1 -->
        <section class="soft-card rounded-[1.5rem] md:rounded-[2rem] p-5 md:p-8 fade-in">
          <h2 class="text-2xl font-semibold text-[var(--brown-deep)]">
            Cela est fait pour vous si…
          </h2>

          <ul class="mt-6 grid md:grid-cols-2 gap-4 text-[var(--text)] leading-relaxed">
            <li class="rounded-[1.25rem] bg-white/70 px-5 py-4 zoom-in">
              Vous sentez que vous ne pouvez plus continuer ainsi, vous avez besoin de retrouver
              du <strong class="font-semibold text-[var(--brown-deep)]">calme</strong>,
              de l’énergie et de la
              <strong class="font-semibold text-[var(--brown-deep)]">sérénité</strong>.
            </li>

            <li class="rounded-[1.25rem] bg-white/70 px-5 py-4 zoom-in">
              Vous souhaitez comprendre ce qui se passe en vous plutôt que de subir vos émotions,
              vos peurs ou vos réactions.
            </li>

            <li class="rounded-[1.25rem] bg-white/70 px-5 py-4 zoom-in">
              Vous cherchez une approche concrète, avec des outils simples à utiliser
              dans votre quotidien.
            </li>

            <li class="rounded-[1.25rem] bg-white/70 px-5 py-4 zoom-in">
              Vous ressentez le besoin de faire une pause, de ralentir et de revenir à vous.
            </li>
          </ul>
        </section>

        <!-- BLOC 2 AVEC IMAGE FLEURS -->
        <section class="mt-8 grid lg:grid-cols-[0.85fr_1.15fr] gap-6 md:gap-8 items-stretch">
          <VerticalImageCard
            src="/images/sophro/fleurs.webp"
            alt="Fleurs au bord de l’eau, nature et sérénité"
            ratio="4 / 5"
            objectPosition="center"
            animation="slide-right"
            className="h-full"
            mobileStart="0%"
            mobileMiddle="50%"
            mobileEnd="100%"
          />

          <div class="soft-card rounded-[1.5rem] md:rounded-[2rem] p-5 md:p-8 slide-left flex flex-col justify-center">
            <h2 class="text-2xl font-semibold text-[var(--brown-deep)]">
              Ce que vous pouvez en attendre
            </h2>

            <ul class="mt-6 space-y-4 text-[var(--text)] leading-relaxed">
              <li class="rounded-[1.25rem] bg-white/70 px-5 py-4 zoom-in">
                • Vous apaiser
              </li>

              <li class="rounded-[1.25rem] bg-white/70 px-5 py-4 zoom-in">
                • Retrouver stabilité émotionnelle et un sommeil plus serein
              </li>

              <li class="rounded-[1.25rem] bg-white/70 px-5 py-4 zoom-in">
                • Renforcer votre confiance en vous
              </li>

              <li class="rounded-[1.25rem] bg-white/70 px-5 py-4 zoom-in">
                • Retrouver stabilité et clarté dans vos choix
              </li>
            </ul>
          </div>
        </section>

        <!-- CITATION -->
        <section class="mt-8 soft-card rounded-[1.5rem] md:rounded-[2rem] p-8 md:p-14 text-center fade-in">
          <p class="mx-auto max-w-4xl text-2xl md:text-3xl leading-relaxed italic text-[var(--brown-deep)]">
            « Prendre soin de soi, c’est se donner la possibilité de vivre plus aligné
            et plus serein. »
          </p>
        </section>

        <!-- FINAL CTA -->
        <section class="mt-8 soft-card rounded-[1.5rem] md:rounded-[2rem] p-5 md:p-8 text-center zoom-in">
          <h2 class="text-2xl font-semibold text-[var(--brown-deep)]">
            Et si vous faisiez le premier pas ?
          </h2>

          <p class="mt-5 mx-auto max-w-3xl text-[var(--text)] leading-relaxed">
            Un premier échange permet souvent de clarifier votre situation
            et de voir si cet
            <strong class="font-semibold text-[var(--brown-deep)]">accompagnement en sophrologie</strong>
            est adapté pour vous.
          </p>

          <p class="mt-6 mx-auto max-w-3xl text-lg font-medium text-[var(--brown-deep)]">
            Pas besoin d’aller bien pour commencer. Une simple envie de pause suffit.
          </p>

          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a
              href="/contact"
              class="soft-btn bg-[var(--brown-soft)] text-white px-7 py-3.5 font-medium inline-block hover:bg-[var(--brown-deep)]"
            >
              Prendre rendez-vous
            </a>

            <a
              href="/accompagnement"
              class="soft-btn border border-[var(--brown-soft)]/20 bg-white/70 px-7 py-3.5 text-[var(--brown-deep)] hover:bg-white"
            >
              Voir les accompagnements
            </a>
          </div>
        </section>

        <!-- DISCLAIMER BAS DE PAGE -->
        <section class="mt-8 text-sm leading-relaxed text-[var(--brown-soft)] text-center px-4">
          <p>
            La sophrologie ne remplace pas un suivi médical ou psychologique lorsque celui-ci est nécessaire.
            Elle peut venir en complément pour vous aider à mieux vivre ce que vous traversez.
          </p>
        </section>
      </section>
    </section>
  </main>

  <Footer />
  <ScrollReveal />
</BaseLayout>